# Database
DATABASE_URL="file:./dev.db"

# Storage for generated docx files (relative to project root)
STORAGE_DIR="./storage"

# Admin auth — set a real password before deploying
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# iron-session cookie secret — generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-real-64-char-hex-string-replace-with-a-real-64-char-hex-string"

# Telegram bot for new-application notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# SMTP for email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@example.com"

# Where to send notification emails (comma-separated)
NOTIFY_EMAIL_TO=""

# Public origin (used in email links)
PUBLIC_BASE_URL="http://localhost:3000"

# LLM-классификация ТН ВЭД по справочнику ЕАЭС
# Приоритет (первый найденный ключ используется):
#   1. Gemini  — БЕСПЛАТНО (1500 запросов/день) — https://aistudio.google.com/
#   2. Groq    — БЕСПЛАТНО (30 запросов/мин)    — https://console.groq.com/keys
#   3. OpenAI  — платно (~$0.0002/вызов)        — https://platform.openai.com/api-keys
# Если ни один не задан — система использует rule-based fallback (deriveTnVedCode)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
