# Production .env template — копировать в /opt/global-test/.env на сервере
# и заменить placeholders на реальные значения

# Database (внутри Docker монтируется в /app/data/prod.db)
DATABASE_URL="file:/app/data/prod.db"
STORAGE_DIR="/app/storage"

# Admin auth — поменять пароль НА БЕЗОПАСНЫЙ
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ЗАМЕНИ_НА_СЛОЖНЫЙ_ПАРОЛЬ"

# iron-session — СГЕНЕРИРОВАТЬ НОВЫЙ для прода:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ВСТАВЬ_СВЕЖИЙ_64_HEX_СЕКРЕТ"

# Telegram bot — создать бота в @BotFather, получить токен, и telegram-chat-id
# Для chat_id: написать боту /start, потом curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN="ВСТАВЬ_ТОКЕН_БОТА_ОТ_BOTFATHER"
TELEGRAM_CHAT_ID="ВСТАВЬ_CHAT_ID"

# SMTP — заполнить если нужны email-уведомления. Пусто = пропускаются.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@forms.legacygroup.work"
NOTIFY_EMAIL_TO=""

# Публичный URL — для ссылок в email
PUBLIC_BASE_URL="https://forms.legacygroup.work"

# LLM-классификатор ТН ВЭД (приоритет: Gemini → Groq → OpenAI)
# Gemini API key: https://aistudio.google.com/apikey (бесплатный тариф)
# Groq: https://console.groq.com/keys
# Все три необязательные — без них работает rule-based классификатор
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
